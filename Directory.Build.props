<Project>
  <PropertyGroup>
    <BaseTargetFramework>net10.0</BaseTargetFramework>
    <WindowsTargetFramework>net10.0-windows10.0.17763.0</WindowsTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Authors>AFGC PC Manager contributors</Authors>
    <Company>AFGC PC Manager contributors</Company>
    <Product>AFGC PC Manager</Product>
    <RepositoryUrl>https://github.com/pinuna27/afgc-pc-manager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2026 AFGC PC Manager contributors</Copyright>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
